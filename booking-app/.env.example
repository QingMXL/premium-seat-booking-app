# ────────────────────────────────────────────────────────────────
# 复制此文件为 .env 并填入真实值（.env 不会被提交到 Git）
# ────────────────────────────────────────────────────────────────

# Supabase 项目 URL（在 Supabase 控制台 → Settings → API 中获取）
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase API Key
# 开发环境可使用 service_role key（跳过 RLS）
# 生产环境请使用 anon key 并启用完整的 RLS 策略
VITE_SUPABASE_KEY=<your-supabase-key>

# 演示用户 ID（临时方案，接入真实 Auth 后移除）
# 可在 Supabase 控制台 → Authentication → Users 中找到
VITE_DEMO_USER_ID=<your-demo-user-uuid>
